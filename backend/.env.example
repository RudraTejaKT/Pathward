PORT=4000

# Sign a long random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret

# From the Razorpay dashboard (Settings -> API Keys). Use the *test* keys
# while developing — they start with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# Resend Email Delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Backlox <support@backlox.site>
RESEND_TAG=rt_backlox

